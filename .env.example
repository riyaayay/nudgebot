# ===========================================================================
# NudgeBot Configuration
# ===========================================================================

# --- Required ---
# From @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Symmetric key for encrypting portal credentials at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-with-python-fernet-generate_key

# Key rotation support: list newest key first, comma-separated (optional):
# ENCRYPTION_KEYS=new_key_here,old_key_here

# --- LLM Summaries (Optional) ---
# Select provider: none | gemini | openai_compat
# - "none": Deterministic template summaries (zero API keys, zero LLM cost, 100% private).
# - "gemini": Google Gemini REST API (default model: gemini-2.5-flash-lite).
# - "openai_compat": OpenAI-compatible endpoint (Groq, OpenRouter, Ollama, etc.).
#
# PRIVACY NOTICE: With a free hosted provider (such as Gemini Free Tier), item titles,
# course codes, and scores are sent to that provider for summarization. The provider's
# free tier terms may state that inputs are used to improve products.
# For complete local privacy, leave LLM_PROVIDER=none or point LLM_BASE_URL to a local Ollama server.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gemini-2.5-flash-lite
LLM_MAX_CALLS_PER_DAY=200

# --- Administration & Access Control ---
# Your numeric Telegram chat ID (send /start to @userinfobot to find it).
# Grants access to /stats, /broadcast, and /users:
ADMIN_TELEGRAM_ID=

# Restrict bot access to specific Telegram chat IDs (comma-separated):
# ALLOWED_TELEGRAM_IDS=12345678,87654321

# Require an invite code to register via /start <code>:
# INVITE_CODE=class2026

# Hard ceiling on registered users:
MAX_USERS=100

# SSRF domain restriction for portals (comma-separated allowlist):
# ALLOWED_PORTAL_DOMAINS=canvas.myschool.edu,portal.myschool.edu

# --- Polling & Reminders Cadence ---
# Default polling interval in minutes:
DEFAULT_POLL_INTERVAL_MINUTES=10

# Hard minimum interval enforced per user in minutes:
MIN_POLL_INTERVAL_MINUTES=5

# Hours before due date to send deadline reminders (comma-separated, e.g. 24h and 3h):
REMINDER_HOURS=24, 3

# Default timezone for new users (valid IANA name, e.g. Asia/Kolkata, America/New_York):
DEFAULT_TIMEZONE=Asia/Kolkata

# Contact email/URL included in User-Agent header when scraping:
USER_AGENT_CONTACT=portal owner

# --- Storage & Operations ---
# SQLite file path:
DATABASE_PATH=data/nudgebot.db

# HTTP port for /healthz endpoint:
HEALTH_PORT=8080

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Logging format: text | json
LOG_FORMAT=text
